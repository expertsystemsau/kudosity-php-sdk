includes:
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - packages/kudosity-client/src
        - packages/kudosity-laravel/src
        - packages/kudosity-laravel/config
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        # Config files use env() and are published to the Laravel config directory
        - identifier: larastan.noEnvCallsOutsideOfConfig
          path: packages/kudosity-laravel/config/*
        # toKudosity is a notification convention method
        -
            message: "#Call to an undefined method Illuminate\\\\Notifications\\\\Notification::toKudosity#"
            path: packages/kudosity-laravel/src/Notifications/KudosityChannel.php
